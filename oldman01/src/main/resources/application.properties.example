server.port=8081
spring.application.name=oldman01

# 数据库连接可直接用环境变量覆盖：OLDMAN_DB_URL / OLDMAN_DB_USER / OLDMAN_DB_PASSWORD
# 也可以复制本文件为 application.properties 后改默认值
spring.datasource.url=${OLDMAN_DB_URL:jdbc:mysql://127.0.0.1:3306/oldman?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=${OLDMAN_DB_USER:root}
spring.datasource.password=${OLDMAN_DB_PASSWORD:your_password_here}

mybatis.configuration.map-underscore-to-camel-case=true
mybatis.mapper-locations=classpath:mapper/*.xml
mybatis.type-aliases-package=com.oldman

spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB
